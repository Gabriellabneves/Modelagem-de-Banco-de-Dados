CREATE TABLE participantes (
    sigla_gp VARCHAR(10),
    num_piloto INT,
    posicao_largada INT,
    PRIMARY KEY (sigla_gp, num_piloto),
    FOREIGN KEY (sigla_gp) REFERENCES corridas(sigla_gp),
    FOREIGN KEY (num_piloto) REFERENCES pilotos(numero)
);


