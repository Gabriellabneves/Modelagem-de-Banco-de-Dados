CREATE TABLE equipes (
    sigla VARCHAR(10) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cod_pais INT,
    FOREIGN KEY (cod_pais) REFERENCES paises(codigo)
);

