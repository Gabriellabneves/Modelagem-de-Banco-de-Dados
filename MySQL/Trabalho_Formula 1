SELECT
    c.nome_gp AS corrida,
    p.nome AS piloto,
    pa.posicao_largada AS posicao
FROM participantes pa
JOIN corridas c ON pa.sigla_gp = c.sigla_gp
JOIN pilotos p ON pa.num_piloto = p.numero;


