CREATE TABLE pilotos (
    numero INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cod_pais INT,
    sigla_equipe VARCHAR(10),
    FOREIGN KEY (cod_pais) REFERENCES paises(codigo),
    FOREIGN KEY (sigla_equipe) REFERENCES equipes(sigla)
);

SELECT * FROM pilotos;


