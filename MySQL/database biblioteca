SELECT livro.titulo, autor.nome
FROM livro
JOIN autor_livro ON livro.codlivro = autor_livro.codlivro
JOIN autor ON autor_livro.mat = autor.mat;


SELECT livro.titulo, autor.nome
FROM livro, autor_livro, autor
WHERE livro.codlivro = autor_livro.codlivro
  AND autor_livro.mat = autor.mat;


SELECT livro.titulo, autor.nome
FROM livro, autor
WHERE EXISTS (
    SELECT 1
    FROM autor_livro
    WHERE autor_livro.codlivro = livro.codlivro
      AND autor_livro.mat = autor.mat
);

